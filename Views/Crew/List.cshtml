   On my honor, as an Aggie, I have neither given nor received unauthorized aid on this academic work. *@
@model IEnumerable<JasperGreen.Models.Crew>
@{
    ViewData["Title"] = "Crews";
}

<h2>Crews</h2>

@if (TempData["message"] is not null)
{
    <div class="alert alert-success">@TempData["message"]</div>
}

<p><a class="btn btn-success" asp-action="Add">Add Crew</a></p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Crew Name</th>
            <th>Foreman</th>
            <th>Member 1</th>
            <th>Member 2</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.CrewName</td>
            <td>@item.CrewForeman?.FullName</td>
            <td>@item.CrewMember1?.FullName</td>
            <td>@item.CrewMember2?.FullName</td>
            <td>
                <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.CrewID">Edit</a>
                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.CrewID">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
