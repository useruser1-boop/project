   On my honor, as an Aggie, I have neither given nor received unauthorized aid on this academic work. *@
@model JasperGreen.Models.Customer
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = Model.CustomerID == 0 ? "Add Customer" : "Edit Customer";
    var states = ViewBag.States as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

<h2>@ViewData["Title"]</h2>

<p class="text-muted">All fields are required. Phone must be 10 digits; ZIP must be 5 or 9 digits (numbers only).</p>

<form asp-action="@(Model.CustomerID == 0 ? "Add" : "Edit")" method="post">
    <input type="hidden" asp-for="CustomerID" />
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="FirstName" class="form-label">First Name *</label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="LastName" class="form-label">Last Name *</label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="CustomerPhone" class="form-label">Phone *</label>
            <input asp-for="CustomerPhone" class="form-control" placeholder="e.g. 9791234567" />
            <small class="form-text text-muted">Enter 10 digits, no spaces or dashes.</small>
            <span asp-validation-for="CustomerPhone" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Email" class="form-label">Email *</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="BillingAddress" class="form-label">Billing Address *</label>
            <input asp-for="BillingAddress" class="form-control" />
            <span asp-validation-for="BillingAddress" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="BillingCity" class="form-label">City *</label>
            <input asp-for="BillingCity" class="form-control" />
            <span asp-validation-for="BillingCity" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="BillingState" class="form-label">State *</label>
            <select asp-for="BillingState" asp-items="states" class="form-select"></select>
            <span asp-validation-for="BillingState" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="BillingZIP" class="form-label">ZIP *</label>
            <input asp-for="BillingZIP" class="form-control" placeholder="e.g. 77840 or 778401234" />
            <small class="form-text text-muted">Enter 5 or 9 digits, no dashes.</small>
            <span asp-validation-for="BillingZIP" class="text-danger"></span>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-success">Save</button>
    </div>
</form>

<form asp-action="Cancel" method="post" class="mt-2">
    <button type="submit" class="btn btn-secondary">Cancel</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
