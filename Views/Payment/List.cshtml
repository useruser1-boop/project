   Description: Displays all payment records sorted by date descending.
   On my honor, as an Aggie, I have neither given nor received unauthorized aid on this academic work. *@
@model IEnumerable<JasperGreen.Models.Payment>
@{
    ViewData["Title"] = "Payments";
}

<h2>Payments</h2>

@if (TempData["message"] is not null)
{
    <div class="alert alert-success">@TempData["message"]</div>
}

<p><a class="btn btn-success" asp-action="Add">Add Payment</a></p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Payment #</th>
            <th>Customer</th>
            <th>Payment Date</th>
            <th>Amount</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.PaymentID</td>
            <td>@item.Customer?.FullName</td>
            <td>@item.PaymentDate.ToShortDateString()</td>
            <td>@item.PaymentAmount.ToString("C")</td>
            <td>
                <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.PaymentID">Edit</a>
                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.PaymentID">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
