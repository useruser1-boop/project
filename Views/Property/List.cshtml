@* File: List.cshtml | Author: Team 05 | Course: ISTM 415 *@
@model IEnumerable<JasperGreen.Models.Property>
@{
    ViewData["Title"] = "Properties";
}

<h2>Properties</h2>

@if (TempData["message"] is not null)
{
    <div class="alert alert-success">@TempData["message"]</div>
}

<p><a class="btn btn-success" asp-action="Add">Add Property</a></p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Customer</th>
            <th>Address</th>
            <th>City</th>
            <th>State</th>
            <th>ZIP</th>
            <th>Service Fee</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Customer?.FullName</td>
            <td>@item.PropertyAddress</td>
            <td>@item.PropertyCity</td>
            <td>@item.PropertyState</td>
            <td>@item.PropertyZIP</td>
            <td>@item.ServiceFee.ToString("C")</td>
            <td>
                <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.PropertyID">Edit</a>
                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.PropertyID">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
