@model List<ProvideService>
@{
    ViewData["Title"] = "Provide Service Events";
}

@if (TempData["message"] != null)
{
    <div class="alert alert-success">@TempData["message"]</div>
}

<div class="mb-3">
    <a asp-action="GetCustomer" class="btn btn-outline-primary">by Customer</a>
    <a asp-action="GetProperty" class="btn btn-outline-primary">by Property</a>
    <a asp-action="GetCrew" class="btn btn-outline-primary">by Crew</a>

    @if (ViewBag.ActiveFilter != null)
    {
        <span class="ms-3 fw-bold">Filtered by: @ViewBag.ActiveFilter</span>
        <form asp-action="ClearFilter" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-secondary btn-sm ms-2">
                Clear Filter
            </button>
        </form>
    }
</div>

<a asp-action="Add" class="btn btn-primary mb-3">Add Service Event</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Service Date</th>
            <th>Customer</th>
            <th>Property</th>
            <th>Crew</th>
            <th>Service Fee</th>
            <th>Paid</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ServiceDate.ToShortDateString()</td>
                <td>@item.Customer?.FullName</td>
                <td>@item.Property?.PropertyAddress</td>
                <td>@item.Crew?.CrewName</td>
                <td>@item.ServiceFee.ToString("C")</td>
                <td>@(item.PaymentID.HasValue ? "Yes" : "No")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ServiceID"
                       class="btn btn-warning btn-sm">Edit</a>

                    <a asp-action="Delete" asp-route-id="@item.ServiceID"
                       class="btn btn-danger btn-sm">Delete</a>

                    <a asp-controller="Payment" asp-action="Add"
                       asp-route-serviceId="@item.ServiceID"
                       class="btn btn-success btn-sm">Payment</a>
                </td>
            </tr>
        }
    </tbody>
</table>