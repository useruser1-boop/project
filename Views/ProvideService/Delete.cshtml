@model ProvideService
@{
    ViewData["Title"] = "Delete Service Event";
}

<h2>@ViewData["Title"]</h2>

<p>Are you sure you want to delete this service event?</p>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Service Date</dt>
            <dd class="col-sm-9">@Model.ServiceDate.ToShortDateString()</dd>

            <dt class="col-sm-3">Customer</dt>
            <dd class="col-sm-9">@Model.Customer?.FullName</dd>

            <dt class="col-sm-3">Property</dt>
            <dd class="col-sm-9">@Model.Property?.PropertyAddress</dd>

            <dt class="col-sm-3">Crew</dt>
            <dd class="col-sm-9">@Model.Crew?.CrewName</dd>

            <dt class="col-sm-3">Service Fee</dt>
            <dd class="col-sm-9">@Model.ServiceFee.ToString("C")</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="ServiceID" />
    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a asp-action="List" class="btn btn-secondary">Cancel</a>
</form>