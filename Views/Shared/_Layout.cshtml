@* File: _Layout.cshtml | Author: Team 05 | Course: ISTM 415 *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Jasper Green</title>
    <link rel="icon" type="image/jpeg" href="~/images/JasperGreenLogo.jpg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

    <!-- ===== HEADER ===== -->
    <header>
        <img src="~/images/JasperGreenLogo.jpg" alt="Jasper Green Logo" class="jg-logo" />
        <span class="jg-brand">Jasper Green</span>
        <small class="text-white-50 ms-1" style="font-size:0.9rem;">Lawn Care Services</small>
    </header>

    <!-- ===== NAVIGATION ===== -->
    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#mainNav" aria-controls="mainNav"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="About">About</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="ContactUs">Contact Us</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Customer" asp-action="List">Customers</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Property" asp-action="List">Properties</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Employee" asp-action="List">Employees</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Crew" asp-action="List">Crews</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="ProvideService" asp-action="List">Services</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Payment" asp-action="List">Payments</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- ===== MAIN CONTENT ===== -->
    <main class="container">
        @RenderBody()
    </main>

    <!-- ===== FOOTER ===== -->
    <footer>
        <p class="mb-0">&copy;Jasper Green - Team 05 - Electronic Eagles</p>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
